# Set these as environment variables in the Claude Code environment settings
# (https://claude.ai/code → environment → Environment variables).
# Never commit real values. Never paste real values into a chat.

# --- Twilio ---------------------------------------------------------------
# Only needed for the REST route (scripts/send-sms.sh). If the Twilio connector
# is enabled for the session, SMS goes through it instead and needs none of this.
#
# TWILIO_ACCOUNT_SID must be the AC... ACCOUNT SID. An SK... value is an API key
# SID and belongs in TWILIO_API_KEY_SID.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Preferred auth: a revocable API key pair.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fallback auth: the account's master token (leave unset if using the API key).
TWILIO_AUTH_TOKEN=

# Sender — set exactly one of these.
TWILIO_FROM_NUMBER=+33XXXXXXXXX
TWILIO_MESSAGING_SERVICE_SID=

# --- SumUp sign-in --------------------------------------------------------
# Google account used to sign in to SumUp via "Continue with Google".
# MUST be the info@chateaudecharmeil.com account.
GOOGLE_EMAIL=info@chateaudecharmeil.com
GOOGLE_PASSWORD=changeme

# Optional fallback: direct SumUp credentials (only if Google SSO is blocked)
SUMUP_EMAIL=
SUMUP_PASSWORD=
